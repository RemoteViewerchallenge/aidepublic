{
  "compilerOptions": {
    /* Type Checking */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Modules */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* Emit */
    "outDir": "./dist",
    "sourceMap": true,

    /* Language and Environment */
    "target": "ES2022",
    "lib": ["ES2022", "dom"],

    /* JSX */
    "jsx": "preserve",
    "incremental": true,

    /* Other */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
