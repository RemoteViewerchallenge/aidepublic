{
  "folders": [
    {
      "name": "DoMoreCo - AI Resource Optimizer",
      "path": "."
    }
  ],
  "settings": {
    "typescript.preferences.moduleSpecifier": "relative",
    "editor.formatOnSave": true,
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-vscode.vscode-typescript-next",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "vitest.explorer",
      "ms-azuretools.vscode-docker"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "dev",
        "type": "shell",
        "command": "npm run dev",
        "group": "build",
        "isBackground": true
      }
    ]
  }
}
