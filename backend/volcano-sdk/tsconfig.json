{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "downlevelIteration": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "tests/**/*.ts",
    "web/**/*.ts",
    "web/**/*.tsx",
    "*.ts"
  ],
  "exclude": ["node_modules", "dist", "examples", "web/dist"]
}
